#!/bin/bash
# sandbox — spin up ONE real AI-infra product in Docker to test aipostex against it.
#
# A dev-machine harness (NOT the lab VMs): stand up a real product, point aipostex at its
# real API, confirm the module is honest, tear it down. This is the realism-principle dev loop
# made fast — and the loop that has caught real tool bugs (MCP, A2A) that tool-shaped mocks hid.
#
# Docker is the right tool HERE: single-service API testing, not the lab's host-path artifact
# scan, so the lab's native-only rationale does not apply.
#
# Usage:
#   sandbox list                 # available services + running status
#   sandbox up <svc>             # start the real product, seed it, print URL + proof command
#   sandbox prove <svc>          # run the matching `aipostex <module>` check against it
#   sandbox down <svc>           # stop + remove (volumes too)
#   sandbox up --all | down --all
#   sandbox logs <svc>           # tail container logs
#
# Each service is services/<svc>.yml (a compose file) + services/<svc>.meta (PORT/URL/DESC/
# HEALTH/PROVE/SEED). The aipostex binary used by `prove` is $AIPOSTEX (default: aipostex on PATH;
# set AIPOSTEX=/path/to/aipostex or 'go run /Users/keys/projects/aipostex/cmd/aipostex').
set -uo pipefail

SANDBOX_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICES_DIR="${SANDBOX_DIR}/services"
PROJECT_PREFIX="aipostex-sb"
AIPOSTEX="${AIPOSTEX:-aipostex}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
log()  { echo -e "${CYAN}[sandbox]${NC} $*"; }
err()  { echo -e "${RED}[sandbox]${NC} $*" >&2; }

require_docker() {
    command -v docker >/dev/null 2>&1 || { err "docker not installed"; exit 1; }
    docker info >/dev/null 2>&1 || { err "docker daemon not running (launch Docker Desktop)"; exit 1; }
}

svc_compose() {  # $1=svc, rest=compose args
    local svc=$1; shift
    docker compose -f "${SERVICES_DIR}/${svc}.yml" -p "${PROJECT_PREFIX}-${svc}" "$@"
}

svc_exists() { [[ -f "${SERVICES_DIR}/$1.yml" ]]; }

# shellcheck disable=SC1090  # meta path is dynamic by design
load_meta() {  # sets PORT URL DESC HEALTH PROVE SEED for $1 (cleared first)
    PORT=""; URL=""; DESC=""; HEALTH=""; PROVE=""; SEED=""
    local meta="${SERVICES_DIR}/$1.meta"
    [[ -f "$meta" ]] && source "$meta"
}

all_services() { find "${SERVICES_DIR}" -name '*.yml' -exec basename {} .yml \; 2>/dev/null | sort; }

is_running() { [[ -n "$(svc_compose "$1" ps -q 2>/dev/null)" ]]; }

cmd_list() {
    echo -e "${CYAN}Available sandbox services:${NC}"
    local svc
    for svc in $(all_services); do
        load_meta "$svc"
        local status; if is_running "$svc"; then status="${GREEN}● up${NC}"; else status="  down"; fi
        printf "  %b  %-12s %-28s %s\n" "$status" "$svc" "${URL:-}" "${DESC:-}"
    done
}

wait_health() {  # $1=svc — poll HEALTH until 200, ~60s
    [[ -z "${HEALTH}" ]] && { sleep 3; return 0; }
    # -k: real products like k3s serve a self-signed cert on HTTPS; harmless for http.
    local _
    for _ in $(seq 1 30); do
        if curl -fsSk -o /dev/null --max-time 4 "${HEALTH}" 2>/dev/null; then return 0; fi
        sleep 2
    done
    err "health check did not pass after ~60s: ${HEALTH} (service may still be coming up)"
    return 1
}

cmd_up() {
    local svc=$1
    svc_exists "$svc" || { err "unknown service '$svc' (try: sandbox list)"; exit 1; }
    load_meta "$svc"
    log "starting ${svc} (${DESC:-})"
    svc_compose "$svc" up -d || { err "compose up failed"; exit 1; }
    log "waiting for ${svc} to be healthy..."
    wait_health "$svc" || true
    if [[ -n "${SEED}" && -f "${SERVICES_DIR}/${SEED}" ]]; then
        log "seeding (${SEED})..."
        AIPOSTEX="${AIPOSTEX}" PORT="${PORT}" URL="${URL}" bash "${SERVICES_DIR}/${SEED}" || err "seed reported a problem (continuing)"
    fi
    echo ""
    echo -e "  ${GREEN}${svc} ready${NC}  →  ${URL}"
    echo -e "  prove:  ${CYAN}sandbox prove ${svc}${NC}"
    echo -e "  down:   ${CYAN}sandbox down ${svc}${NC}"
}

cmd_prove() {
    local svc=$1
    svc_exists "$svc" || { err "unknown service '$svc'"; exit 1; }
    load_meta "$svc"
    [[ -z "${PROVE}" ]] && { err "no PROVE command defined for ${svc}"; exit 1; }
    is_running "$svc" || err "warning: ${svc} does not look running; 'sandbox up ${svc}' first"
    log "proving ${svc} with: AIPOSTEX=${AIPOSTEX}"
    echo -e "${YELLOW}\$ ${PROVE}${NC}"
    AIPOSTEX="${AIPOSTEX}" eval "${PROVE}"
}

cmd_down() {
    local svc=$1
    svc_exists "$svc" || { err "unknown service '$svc'"; exit 1; }
    log "stopping ${svc}..."
    svc_compose "$svc" down -v
}

cmd_logs() { svc_exists "$1" || { err "unknown service '$1'"; exit 1; }; svc_compose "$1" logs --tail=80 -f; }

main() {
    [[ $# -lt 1 ]] && { sed -n '15,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1; }
    local action=$1; shift
    case "$action" in
        list) cmd_list ;;
        up)
            require_docker
            if [[ "${1:-}" == "--all" ]]; then for s in $(all_services); do cmd_up "$s"; done
            else [[ $# -ge 1 ]] || { err "usage: sandbox up <svc|--all>"; exit 1; }; cmd_up "$1"; fi ;;
        down)
            require_docker
            if [[ "${1:-}" == "--all" ]]; then for s in $(all_services); do is_running "$s" && cmd_down "$s"; done
            else [[ $# -ge 1 ]] || { err "usage: sandbox down <svc|--all>"; exit 1; }; cmd_down "$1"; fi ;;
        prove)  require_docker; [[ $# -ge 1 ]] || { err "usage: sandbox prove <svc>"; exit 1; }; cmd_prove "$1" ;;
        logs)   require_docker; [[ $# -ge 1 ]] || { err "usage: sandbox logs <svc>"; exit 1; }; cmd_logs "$1" ;;
        -h|--help) sed -n '15,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
        *) err "unknown action '$action'"; exit 1 ;;
    esac
}
main "$@"
