#cloud-config
hostname: ${hostname}
manage_etc_hosts: false

# labadmin is the account deploy-all.sh SSHes into (labadmin@<host>), so it must
# carry the operator key — the instance key_name only lands on the default user.
users:
  - default
  - name: labadmin
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_authorized_key}

write_files:
  - path: /etc/hosts
    append: true
    content: |
      ${hosts_entries}

runcmd:
  - apt-get update -qq
  - apt-get install -y -qq curl jq python3 python3-pip python3-venv git net-tools
  - sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - systemctl restart sshd
